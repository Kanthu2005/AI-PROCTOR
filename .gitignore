# ==========================================
# ProctorAI - Git Ignore Configuration
# ==========================================

# Python Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Python Virtual Environments
.venv/
venv/
ENV/
env/
.env/
*/venv/
*/.venv/

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Node / Frontend Build Outputs & Dependencies
node_modules/
*/node_modules/
dist/
*/dist/
build/
*/build/
.vite/
*/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment & Secrets (NEVER commit secrets or real credentials)
.env
.env.local
.env.*.local
*.env
!.env.example
!backend/.env.example
!frontend/.env.example

# Local SQLite / Temporary Databases (NEVER commit local databases)
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm
intellitest.db
backend/intellitest.db

# OS Artifacts
.DS_Store
Thumbs.db
Desktop.ini
desktop.ini

# IDE & Editor Settings & Agent Artifacts
.vscode/
.idea/
*.swp
*.swo
.gemini/
.agents/

# Logs & Temporary Files
*.log
logs/
docker-compose.override.yml
