# ==============================================================================
# ProctorAI Backend - Environment Configuration
# ==============================================================================
# Copy this file to .env and replace placeholder values with your environment configuration.
# DO NOT commit real secrets or passwords to version control.

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
PROJECT_NAME="ProctorAI - AI-Powered Assessment & Proctoring Platform"
API_V1_STR=/api/v1

# Security & JWT Secrets
# Generate a strong 32+ character random secret for production (e.g. openssl rand -hex 32)
SECRET_KEY=replace-with-a-very-secure-32char-random-secret-key-for-jwt-signing
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720
INVITATION_TOKEN_EXPIRE_HOURS=72

# Dedicated PostgreSQL Database Configuration (Least Privilege)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=proctorai_user
POSTGRES_PASSWORD=replace_with_secure_proctorai_password
POSTGRES_DB=proctorai_db

# Primary Database Connection URL (Relational Data: Users, Exams, Invitations, Attempts)
# 1. Supabase (Recommended Managed PostgreSQL - Free & does NOT expire after 30 days):
# DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
# 2. Render Managed PostgreSQL:
# DATABASE_URL=postgresql://proctorai_user:password@dpg-...-a.oregon-postgres.render.com/proctorai_db
# 3. Local SQLite Fallback:
# DATABASE_URL=sqlite:///./intellitest.db

# Database Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# High-Volume Proctoring Telemetry Store (Face detection frames, eye tracking, keystroke logs)
# 1. MongoDB Atlas (Free M0 Cluster):
# MONGODB_URL=mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/?retryWrites=true&w=majority
# 2. Local MongoDB:
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=proctorai_telemetry

# Execution Sandbox
USE_DOCKER_SANDBOX=False
DOCKER_SANDBOX_IMAGE=python:3.11-slim
SANDBOX_TIMEOUT_SECONDS=3
SANDBOX_MEMORY_LIMIT=128m
SANDBOX_CPU_QUOTA=50000

# CORS Allowed Origins (Comma-separated list or *)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# Email Service Configuration (Real Transactional Delivery)
EMAIL_PROVIDER=resend
EMAIL_FROM_ADDRESS=assessments@example.com
EMAIL_FROM_NAME="ProctorAI Assessments"
RESEND_API_KEY=replace_with_your_resend_api_key

# Alternatively, SMTP configuration:
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_smtp_user@gmail.com
# SMTP_PASSWORD=your_smtp_app_password
# SMTP_USE_TLS=True
# SMTP_USE_SSL=False

# Webhook secret for delivery confirmation (Optional)
EMAIL_WEBHOOK_SECRET=replace_with_webhook_signing_secret

# Application URLs
FRONTEND_BASE_URL=http://localhost:5173
BACKEND_BASE_URL=http://localhost:8000

