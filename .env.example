# ==============================================================================
# ProctorAI - Root Environment Configuration Example
# ==============================================================================
# Never commit credentials or real production secrets to version control.

# Backend Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=replace-with-a-very-secure-32char-random-secret-key-for-jwt-signing

# Dedicated PostgreSQL
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=proctorai_user
POSTGRES_PASSWORD=replace_with_secure_proctorai_password
POSTGRES_DB=proctorai_db
# Primary Relational Database (Users, Exams, Questions, Attempts, Violations)
# Option A: Supabase (Recommended - Free & persistent PostgreSQL):
# DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
# Option B: Local SQLite fallback:
# DATABASE_URL=sqlite:///./intellitest.db
DATABASE_URL=postgresql://proctorai_user:replace_with_secure_proctorai_password@localhost:5432/proctorai_db

# High-Volume Telemetry & Proctoring Logs (Face tracking, frames, keystroke telemetry)
# Option A: MongoDB Atlas (Free M0 Cluster):
# MONGODB_URL=mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/?retryWrites=true&w=majority
# Option B: Local MongoDB:
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=proctorai_telemetry

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Email Service Configuration (Real Transactional Delivery)
EMAIL_PROVIDER=resend
EMAIL_FROM_ADDRESS=assessments@example.com
EMAIL_FROM_NAME="ProctorAI Assessments"
RESEND_API_KEY=replace_with_your_resend_api_key
FRONTEND_BASE_URL=http://localhost:5173
BACKEND_BASE_URL=http://localhost:8000
