# ==============================================================================
# ProctorAI - Root Environment Configuration Example
# ==============================================================================
# Never commit credentials or real production secrets to version control.

# Backend Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=replace-with-a-very-secure-32char-random-secret-key-for-jwt-signing

# Dedicated PostgreSQL
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=proctorai_user
POSTGRES_PASSWORD=replace_with_secure_proctorai_password
POSTGRES_DB=proctorai_db
DATABASE_URL=postgresql://proctorai_user:replace_with_secure_proctorai_password@localhost:5432/proctorai_db

# MongoDB Telemetry
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=proctorai_telemetry

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000/api/v1
